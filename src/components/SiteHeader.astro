---
import { SITE } from '../site.config.js';
import { link } from '../link.js';
import { MODULES } from '../modules/index.js';

const { current } = Astro.props;
---

<header class="header">
  <a class="mark" href={link('/')} aria-label={SITE.name}>
    <svg viewBox="0 0 32 32" aria-hidden="true" class="mark__glyph">
      <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none">
        <path d="M21 16 L28 16" /><path d="M19.1 20.9 L23.5 25.4" />
        <path d="M14.9 20.9 L13.3 25.7" /><path d="M11.5 18.2 L5.2 21.2" />
        <path d="M11.5 13.8 L5.2 10.8" /><path d="M14.9 11.1 L13.3 6.3" />
        <path d="M19.1 12.1 L23.5 6.6" />
      </g>
      <circle cx="16" cy="16" r="3.4" fill="currentColor" />
    </svg>
    <span class="mark__word">{SITE.name}</span>
  </a>

  <nav class="nav">
    <a href={link('/#modules')} class="nav__link" aria-current={current === 'modules' ? 'page' : undefined}>
      modules<span class="nav__count">{MODULES.length}</span>
    </a>
    <a href={link('/#lift')} class="nav__link">lift</a>
    <a href={SITE.links.github} class="nav__link" rel="me noreferrer" target="_blank">github</a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    width: var(--page);
    margin-inline: auto;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--void) 82%, transparent);
    backdrop-filter: blur(14px);
  }

  .mark {
    display: flex;
    align-items: center;
    gap: 0.6em;
    color: var(--gold);
  }

  .mark__glyph {
    width: 22px;
    height: 22px;
    animation: turn 26s linear infinite;
  }

  @keyframes turn { to { transform: rotate(360deg); } }

  .mark__word {
    font-family: var(--font-display);
    font-size: var(--text-md);
    letter-spacing: 0.34em;
    color: var(--text);
  }

  .nav {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .nav__link { transition: color 0.3s var(--ease); }
  .nav__link:hover, .nav__link[aria-current='page'] { color: var(--gold); }

  .nav__count {
    margin-left: 0.5em;
    color: var(--text-faint);
    font-size: 0.85em;
  }

  /* On the narrowest phones the third link is noise. */
  @media (max-width: 26em) {
    .nav__link:nth-child(2) { display: none; }
  }
</style>
